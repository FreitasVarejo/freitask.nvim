{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "freitask statuses --json",
  "description": "O vocabulário de fases em ordem crescente de num, começando pelo sentinela 0.",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "callout",
      "hidden",
      "hl_group",
      "icon",
      "num",
      "title"
    ],
    "properties": {
      "callout": {
        "type": "string",
        "minLength": 1
      },
      "hidden": {
        "type": "boolean"
      },
      "hl_group": {
        "type": "string"
      },
      "icon": {
        "type": "string"
      },
      "num": {
        "type": "integer",
        "minimum": 0
      },
      "title": {
        "type": "string"
      }
    }
  }
}
